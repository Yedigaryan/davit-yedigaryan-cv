{
  "name": "davit-yedigaryan-cv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "npx serve@latest out",
    "build-serve": "pnpm run build && pnpm run serve",
    "lint": "eslint",
    "postbuild": "pnpm run copy-static",
    "copy-static": "mkdir -p .next/standalone/public && cp -r public/* .next/standalone/public/ && mkdir -p .next/standalone/.next/static && cp -r .next/static/* .next/standalone/.next/static/",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry-run",
    "deploy:fast": "bash scripts/deploy.sh --skip-build",
    "deploy:git": "bash scripts/deploy-git.sh",
    "deploy:git:push": "bash scripts/deploy-git.sh --push",
    "deploy:check": "bash scripts/check-deploy.sh",
    "deploy:check:full": "bash scripts/check-deploy.sh --verbose",
    "deploy:find-root": "bash scripts/find-docroot.sh"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "next": "15.5.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5"
  }
}